    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "migrated",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMはローカルネットワークを使用してUTMリモートサーバを検索し、接続します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM używa sieci lokalnej, aby znaleźć i połączyć się do zdalnych serwerów UTM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM 使用本地网络查找并连接到 UTM 远程服务器。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM 使用本地網絡尋找並連接至 UTM 遠端伺服器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "migrated",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンがマイクから録音するには、アクセス許可が必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane są uprawnienia dla maszyny wirtualnej, aby używać mikrofonu."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何虚拟机都需要获得许可才能从麦克风录音。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何虛擬電腦都需要許可才能由咪高風進行錄製。"
          }
        }
      }
    }
