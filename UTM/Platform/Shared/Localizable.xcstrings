    "Suspend is not supported for virtualization." : {
      "comment" : "UTMQemuVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدعم خاصية الإيقاف المؤقت في بيئة الافتراضية."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suspension n’est pas prise en charge pour la virutualisation."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サスペンドは仮想化には対応していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymywanie nie jest wspierane dla wirtualizacji."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "挂起功能不支持虚拟化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「虛擬化」不支援暫停。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暫停功能不支援虛擬化。"
          }
        }
      }
    },
    "Suspend is not supported when an emulated NVMe device is active." : {
      "comment" : "UTMQemuVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدعم خاصية الإيقاف المؤقت عندما يكون جهاز NVMe المحاكي نشطًا."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suspension n’est pas prise en charge lorsque un appareil NVMe émulé est actif."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サスペンドは仮想NVMeデバイスがアクティブな場合には対応していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymywanie nie jest wspierane, gdy emulowane urządzenie NVMe jest aktywne."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当模拟的 NVMe 设备处于活动状态时不支持挂起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用模擬的 NVMe 裝置時不支援暫停。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当仿真 NVMe 裝置處於啟用狀態時，不支援暫停功能。"
          }
        }
      }
    },
    "Suspend is not supported when GPU acceleration is enabled." : {
      "comment" : "UTMQemuVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تدعم خاصية الإيقاف المؤقت عند تمكين تسريع GPU."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suspension n’est pas prise en charge lorsque l’accélération avec le GPU est activée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サスペンドはGPUアクセラレーションが有効な場合には対応していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymywanie nie jest wspierane, gdy akceleracja grafiki jest włączona."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "启用 GPU 加速时不支持挂起。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "啟動 GPU 加速時不支援暫停。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 GPU 加速處於啟用狀態時，不支援暫停功能。"
          }
        }
      }
    },
    "Suspend state cannot be saved when running in disposible mode." : {
      "comment" : "UTMQemuVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن حفظ حالة الإيقاف المؤقت عند التشغيل في وضع التخلص."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使い捨てモードで動作している場合、サスペンド状態を保存することはできません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stan wstrzymania nie może być zapisany w trybie jednorazowym"
