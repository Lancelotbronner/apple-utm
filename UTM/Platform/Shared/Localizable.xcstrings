    "This virtual machine contains an invalid hardware model. The configuration may be corrupted or is outdated." : {
      "comment" : "UTMAppleConfiguration",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي هذه الآلة الافتراضية على نموذج عتاد غير صالح. قد يكون التكوين تالفًا أو قديمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM enthält ein nicht unterstütztes Hardware-Modell. Möglicherweise ist die Konfiguration beschädigt oder veraltet."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
