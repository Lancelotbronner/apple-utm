    "Should be off for older operating systems such as Windows 7 or lower." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون مغلقًا للأنظمة القديمة مثل Windows 7 أو أقل."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debería estar desactivado para sistemas operativos más antiguos, como Windows 7 o inferior."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitäisi olla pois päältä vanhemmissa käyttöjärjestelmissä, kuten Windows 7 tai vanhemmissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devrait être désactivé pour les anciens systèmes d’exploitation tels que Windows 7 et antérieurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovrebbe essere disattivato per sistemi operativi come Windows 7 o precedenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows 7以前など、古いオペレーティングシステムに対してはオフにしておく必要があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powinno zostać wyłączone dla starszych systemów np. Windows 7 lub starsze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для старых операционных систем, таких как Windows 7 или ниже, его следует отключить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对于较旧的操作系统应关闭此选项，例如 Windows 7 或者更低版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "舊版作業系統如 Windows 7 或更舊版本應當 off。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對於較舊的作業系統應關閉，例如 Windows 7 或者更低版本。"
          }
        }
      }
    },
    "Should be on always unless the guest cannot boot because of this." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب أن يكون مفعلًا دائمًا إلا إذا كانت الآلة الافتراضية لا تستطيع التمهيد بسبب ذلك."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debería de estar siempre activo, a menos que el invitado no pueda arrancar debido a esto."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitäisi olla päällä aina, ellei vieras voi käynnistyä tämän vuoksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devrait toujours être activé sauf si l’OS client ne peut démarrer à cause de celà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dovrebbe essere attivo, a meno che il sistema operativo Guest abbia problemi di avvio a causa di questa opzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これが原因でゲストが起動できない場合を除き、常にオンにしておくべきです。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powinno być zawsze włączone, chyba że powoduje problemy z uruchomieniem gościa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Должно быть включено всегда, если только гость не может загрузиться из-за этого."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非客户机因此无法启动，否则此项应始终打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非客體因此無法啟動，否則任何情境下都應當 on。"
          }
        },
        "zh-HK" : {
