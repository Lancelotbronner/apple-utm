    "Force multicore may improve speed of emulation but also might result in unstable and incorrect emulation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرض استخدام عدة أنوية قد يحسن سرعة المحاكاة ولكنه قد يؤدي أيضًا إلى محاكاة غير مستقرة وغير صحيحة."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar multinúcleo puede mejorar la velocidad de la emulación, pero también puede resultar en una emulación inestable e incorrecta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moniytimen pakottaminen voi parantaa emuloinnin nopeutta, mutta se voi myös johtaa epävakaaseen ja virheelliseen emulointiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forcer le multicœurs peut accélérer l’émulation mais également la rendre instable et incorrecte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzare l'uso del Multicore potrebbe incrementare la velocità emulazione, ma potrebbe risultare in emulazione scorretta o instabile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マルチコアを強制すると、エミュレーションの速度は向上しますが、エミュレーションが不安定になったり、正しく実行されなかったりする可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuszenie wielowątkowości może poprawić prędkość emulacji, ale również może sprawić, że będzie ona nieprawidłowa i niestabilna."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительная многоядерность может повысить скорость эмуляции, но при этом может привести к нестабильной и некорректной эмуляции."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制多核可以提高模拟速度，但也可能导致模拟不稳定和不正确。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制使用多核心或許可以提高模擬速度，但也會導致不穩定和模擬錯誤等問題。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強行多核心可能會提高仿真速度，但也會導致不穩定與錯誤的仿真。"
          }
        }
      }
    },
