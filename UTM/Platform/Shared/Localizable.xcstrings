      "localizations" : {
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porada : Dla jak najlepszego doświadczenia z korzystania z Windowsa, upewnij się, że pobrałeś i zainstalowałeś najnowsze [sterowniki SPICE oraz QEMU](https:/*mac.getutm.app/support/)."
