    "PS/2 has higher compatibility with older operating systems but does not support custom cursor settings." : {
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2 tiene una mayor compatibilidad con sistemas operativos antiguos, pero no soporta configuraciones personalizadas del cursor."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2:lla on parempi yhteensopivuus vanhempien käyttöjärjestelmien kanssa, mutta se ei tue mukautettuja kohdistimen asetuksia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2 ha una compatibilità superiore con i sistemi operativi più vecchi, ma non supporta le impostazioni specifiche del cursore."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2는 오래된 운영체제에서 더 나은 호환성을 가지지만 커스텀 커서에 관한 설정을 지원하지 않습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2 ma większą kompatybilnść ze starszymi systemami operacyjnymi, ale nie wspiera obecnych ustawień kursora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PS/2 имеет более высокую совместимость со старыми операционными системами, но не поддерживает пользовательские настройки курсора."
          }
        }
      }
    },
