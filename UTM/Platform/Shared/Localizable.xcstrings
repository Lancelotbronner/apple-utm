        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить моментальный снимок ВМ. Обычно это означает, что по крайней мере одно устройство не поддерживает моментальные снимки."
          }
        }
      }
    },
    "Failed to save VM snapshot. Usually this means at least one device does not support snapshots. %@" : {
