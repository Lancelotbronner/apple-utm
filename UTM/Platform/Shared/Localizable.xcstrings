          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックを入れると、CPUフラグが有効になります。そうでない場合、デフォルトの値が使用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeśli zaznaczone, flagi procesora będą włączone. W przeciwnym wypadku zostaną użyte domyślne wartości."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Если флажок установлен, то флаг CPU будет включен. В противном случае будет использоваться значение по умолчанию"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若选中，将启用 CPU 标志。否则将使用默认值。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "核取後會啟用 CPU 旗標。反之則使用預設值。"
