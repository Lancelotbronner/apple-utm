    "Allocating too much memory will crash the VM." : {
      "comment" : "VMConfigSystemView",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي تخصيص الكثير من الذاكرة إلى تعطل الآلة الافتراضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zu viel zugewiesener Speicher führt zum Absturz der VM."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservar mucha memoria bloqueará la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La VM va planter si vous allouez trop de mémoire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allocare troppa memoria causerà crash della Macchina Virtuale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリを過剰に割り当てると、仮想マシンがクラッシュします。"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделение слишком большого объема памяти приведет к вылету ВМ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分配过多内存会使虚拟机崩溃。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置過多記憶體會導致虛擬機當機。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分配過多記憶體會使虛擬電腦當機。"
          }
        }
      }
    },
    "Allocating too much memory will crash the VM. Your device has %llu MB of memory and the estimated usage is %llu MB." : {
      "comment" : "VMConfigSystemView",
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asignar demasiada memoria bloqueará la VM. Tu dispositivo tiene %llu MB de memoria y el uso estimado es de %llu MB."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liian paljon muistia kaataa virtuaalikoneen. Laitteessa on %llu Mt muistia ja arvioitu käyttö on %llu MB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allocare troppa memoria causerà crash della Macchina Virtuale. Il tuo dispositivo dispone di %llu MB di memoria e l'uso stimato è di %llu MB."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 많은 양의 메모리를 할당하면 VM이 충돌할 수 있습니다. 이 기기는 총 %1$llu MB 메모리를 탑재하였으며, 현재 %2$llu MB 사용중입니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przydzielenie zbyt dużej ilości pamięci sprawi, że maszyna wirtualna się zawiesi. Twoje urządzenie ma %llu MB i szacowane zużycie pamięci to %llu MB."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выделение слишком большого объема памяти приведет к вылету ВМ. На вашем устройстве имеется %llu МБ памяти, а предполагаемое использование составляет %llu МБ."
          }
        }
      }
    },
