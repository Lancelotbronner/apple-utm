    "These are advanced settings affecting QEMU which should be kept default unless you are running into issues." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه إعدادات متقدمة تؤثر على QEMU ويجب الحفاظ على الإعدادات الافتراضية ما لم تواجه مشاكل."
          }
        },
        "es-419" : {
          "stringUnit" : {
