    "Are you sure you want to delete this directory? All files and subdirectories WILL be deleted." : {
      "comment" : "VMConfigDirectoryPickerViewController",
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro/a de querer eliminar este directorio? Todos los archivos y subdirectorios serán ELIMINADOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti poistaa tämän hakemiston? Kaikki tiedostot ja alihakemistot poistetaan."
