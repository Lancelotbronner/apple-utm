    "Closing a VM without properly shutting it down could result in data loss." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي إغلاق آلة افتراضية دون إيقافها بشكل صحيح إلى فقدان البيانات."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiusura di una VM senza il corretto spegnimento potrebbe comportare perdita di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンを適切にシステム終了せずに閉じると、データが失われる可能性があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie maszyny wirtualnej bez poprawnego jej wyłączenia może poskukować utratą danych"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不正确关闭电源的情况下关闭虚拟机可能会导致数据丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不先正確關機而直接關閉虛擬機，可能導致資料遺失。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在未正確關閉電源的情況下關閉虛擬電腦可能會導致資料遺失。"
          }
        }
      }
    },
    "Closing this window will kill the VM." : {
      "comment" : "VMQemuDisplayMetalWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي إغلاق هذه النافذة إلى قتل الآلة الإفتراضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Schließen des Fensters wird die VM direkt beenden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar esta ventana matará la VM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer cette fenêtre tuera la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudere questa finestra terminerà la Macchina Virtuale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウを閉じると、仮想マシンを強制終了します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie wszystkich okien zakończy pracę maszyny wirtualnej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытие этого окна приведет к завершению работы ВМ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此窗口将终止此虚拟机。"
