        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta wersja macOS nie wspiera dźwięku w trybie konsolowym. Proszę zweryfikować konfigurację wirtualnej maszyny lub zaktualizować macOS."
