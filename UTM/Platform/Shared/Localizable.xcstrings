          }
        }
      }
    },
    "Hint: To show the toolbar again, use a three-finger swipe down on the screen." : {
      "comment" : "VMDisplayViewController",
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pista: Para mostrar de nuevo la barra de herramientas, desliza hacia abajo con 3 dedos en la pantalla."
          }
        },
        "fi" : {
