    "Are you sure you want to reset this VM? Any unsaved changes will be lost." : {
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت متأكد أنك تريد إعادة تعيين هذا الجهاز الافتراضي؟ سيتم فقدان أي تغييرات غير محفوظة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Möchten Sie wirklich einen Reset der VM ausführen? Alle ungespeicherten Änderungen gehen dabei verloren."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro/a de querer reiniciar esta VM? Se perderá cualquier cambio no guardado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko varmasti nollata tämän virtuaalikoneen? Kaikki tallentamattomat muutokset menetetään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir réinitialiser cette VM ? Tout changement apporté sera perdu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler riavviare questa Macchina Virtuale? Le modifiche non salvate andranno perse."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この仮想マシンをリセットしてもよろしいですか? 保存されていない変更内容は失われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM을 리셋하시겠습니까? 모든 저장하지 않은 변경사항은 유실됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jesteś pewien że chcesz zresetować tą wirtualną maszynę? Wszelkie niezapisane dane zostaną utracone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы уверены, что хотите перезапустить эту ВМ? Все несохраненные изменения будут потеряны."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "确定要重置此虚拟机吗？任何未保存的更改都将丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您確定要重設這台虛擬機嗎？這樣會遺失所有未儲存更改。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你確定要重設這個虛擬電腦嗎？任何未儲存的變更都將遺失。"
          }
        }
      }
    },
