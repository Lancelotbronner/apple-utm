          "stringUnit" : {
            "state" : "translated",
            "value" : "ThreadX"
          }
        }
      }
    },
    "Timed out trying to connect." : {
      "comment" : "UTMRemoteConnectView",
      "extractionState" : "migrated",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
