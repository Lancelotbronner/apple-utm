          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuś wielowątkowość"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительно включить многоядерность"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制多核"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制多核心模式"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強行多核心"
          }
        }
      }
