        }
      }
    },
    "This version of macOS does not support audio in console mode. Please change the VM configuration or upgrade macOS." : {
      "comment" : "UTMQemuSystem",
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta versión de macOS no soporta audio en el modo de consola. Por favor cambia la configuración de la VM o actualiza macOS."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä macOS-versio ei tue ääntä konsolitilassa. Muuta VM-kokoonpanoa tai päivitä macOS."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa versione di macOS non supporta l'audio in modalità console. Cambia la configurazione della VM o aggiorna macOS."
