    "Failed to save VM snapshot. Usually this means at least one device does not support snapshots." : {
      "extractionState" : "manual",
      "localizations" : {
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo guardar la instantánea de la VM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM-vedoksen tallentaminen epäonnistui. Yleensä tämä tarkoittaa, että ainakin yksi laite ei tue tilannekuvia."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile salvare l'istantanea della VM. Generalmente, questo significa che almeno uno dei dispositivi non supporta le istantanee."
