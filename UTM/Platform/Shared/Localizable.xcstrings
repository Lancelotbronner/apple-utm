          }
        }
      }
    },
    "The selected boot image contains the word '%@' but the guest architecture is '%@'. Please ensure you have selected an image that is compatible with '%@'." : {
      "comment" : "VMWizardState",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتوي صورة التمهيد المحددة على الكلمة '%@' ولكن بنية الضيف هي '%@'. يرجى التأكد من أنك قد اخترت صورة متوافقة مع '%@'."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gewählte Start-Abbild enthält das Wort „%1$@”, die Gast-Architektur ist jedoch „%2$@”. Bitte stellen Sie sicher, dass Sie ein passendes Abbild für „%3$@” ausgewählt haben."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de arranque seleccionada contiene la palabra “%1$@“, pero la arquitectura invitada es “%2$@“. Por favor asegúrese de que tiene seleccionada una imagen que es compatible con “%3$@“."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'immagine di avvio contiene la parola “%1$@“, mentre l'architettura guest è “%2$@“. Assicurati di aver selezionato un'immagine compatibile con “%3$@“."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択された起動イメージには単語“%1$@”が含まれていますが、ゲストアーキテクチャは“%2$@”になっています。“%3$@”と互換性のあるイメージが選択されていることを確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany obraz zawiera słowo '%@' ale architekturą gościa jest '%@'. Upewnij się, że wybrałeś obraz który jest kompatybilny z '%@'."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный загрузочный образ содержит слово “%1$@“, но гостевая архитектура -  “%2$@“. Убедитесь, что выбран образ, совместимый с “%3$@“."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选的引导映像名称包含 '%@'，但客户机的架构为 '%@'。请确保你选择了与 '%@' 兼容的映像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇的開機映像檔包含「%1$@」單字，但客體架構是「%2$@」。請確保您選擇得是相容「%3$@」的映像檔。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選取的啟動映像檔包含單字「%1$@」，但客戶端體系結構為「%2$@」。確保你選取了與「%3$@」體系結構相容的映像檔。"
          }
        }
      }
    },
    "The server interface version does not match the client." : {
      "comment" : "UTMRemoteClient",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
