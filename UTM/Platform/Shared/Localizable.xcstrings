    "This host is not yet trusted. You should verify that the fingerprints match what is displayed on the host and then select Trust to continue." : {
      "comment" : "UTMRemoteClient",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا المضيف لم يُوثق بعد. يجب عليك التحقق من أن بصمات الأصابع تتطابق مع ما هو معروض على المضيف ثم اختيار \"ثقة\" للمتابعة."
          }
        },
        "ja" : {
          "stringUnit" : {
