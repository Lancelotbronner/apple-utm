    "Instantiate PS/2 controller even when USB input is supported. Required for older Windows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تكوين وحدة تحكم PS/2 حتى عند دعم إدخال USB. مطلوب لنظم Windows القديمة."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar el controlador PS/2 incluso si la entrada USB está soportada. Requerido para versiones de Windows antiguas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantoi PS/2-ohjain, vaikka USB-tuloa tuetaan. Vaaditaan vanhemmille Windowsille."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instancie le contrôleur PS/2 même lorsque l’entrée en USB est prise en charge. Requis pour les anciens Windows."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inizializza il controller PS/2 anche quando l'input USB è supportato. Richiesto per versioni più vecchie di Windows."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "USB入力に対応している場合でも、PS/2コントローラをインスタンス化します。古いWindowsで必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utwórz instancję kontrolera PS/2 nawet jeśli kontroler USB jest wspierany. Wymagane dla starszych wersji systemu Windows."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инстанцировать контроллер PS/2, даже если поддерживается USB ввод. Требуется для старых версий Windows."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即便支持 USB 输入，仍然实例化 PS/2 控制器。此功能对于旧版 Windows 为必需。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使支援 USB 輸入，依舊實體化 PS/2 控制器。舊版 Windows 需要。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即便支援 USB 輸入，仍然例項化 PS/2 控制器。這個功能對於舊版 Windows 為必需。"
          }
        }
      }
    },
