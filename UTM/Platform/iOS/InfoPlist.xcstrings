    "NSMicrophoneUsageDescription" : {
      "comment" : "Privacy - Microphone Usage Description",
      "extractionState" : "migrated",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Mikrofonzugriff in der VM wird Ihre Erlaubnis benötigt."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La máquina virtual necesita el acceso al micrófono."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuaalikone vaatii pääsyn mikrofoniin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La machine virtuelle nécessite un accès au microphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette alle Macchine Virtuali di accedere al Microfono"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンがマイクから録音するには、アクセス許可が必要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymagane są uprawnienia dla maszyny wirtualnej, aby używać mikrofonu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виртуальной машине необходим доступ к микрофону."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何虚拟机都需要获得许可才能从麦克风录音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "虛擬機需要麥克風存取權。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何虛擬電腦都需要許可才能由咪高風進行錄製。"
          }
        }
      }
